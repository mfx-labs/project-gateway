{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-gateway:schema:registry:1.0:extension-contract-entry",
  "title": "Registered extension contract entry",
  "type": "object",
  "required": [
    "version",
    "payload_schema_id",
    "semantic_contract_ids",
    "supported_kinds",
    "supported_modes",
    "ignore_safety",
    "deprecation",
    "supersession"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "payload_schema_id": {
      "const": "urn:project-gateway:schema:artifact:1.0:common:extension-declaration"
    },
    "semantic_contract_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(ART|TSK|AUT|CTX|CMP|BND|RES|REF|WSP|LIN|REG|LFC|EXE|PUB|MIG|SEC)-[0-9]{3}$"
      }
    },
    "supported_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "kind_id",
          "kind_version"
        ],
        "properties": {
          "kind_id": {
            "enum": [
              "TaskSpec",
              "AuthorityPolicy",
              "ContextManifest",
              "CompletionContract",
              "ExecutionBundle",
              "ExecutionResult"
            ]
          },
          "kind_version": {
            "const": "1.0"
          }
        },
        "unevaluatedProperties": false
      }
    },
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "required",
          "optional"
        ]
      }
    },
    "ignore_safety": {
      "enum": [
        "ignore-safe",
        "not-ignore-safe"
      ]
    },
    "deprecation": {
      "$ref": "urn:project-gateway:schema:registry:1.0:deprecation-declaration"
    },
    "supersession": {
      "$ref": "urn:project-gateway:schema:registry:1.0:supersession-declaration"
    }
  },
  "unevaluatedProperties": false
}
